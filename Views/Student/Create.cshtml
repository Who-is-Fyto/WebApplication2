@model WebApplication2.Models.Student

@{
    ViewData["Title"] = "Add Student";
}

<h2>Add Student</h2>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="EnrollementDate" class="form-label"></label>
        <input asp-for="EnrollementDate" class="form-control" />
        <span asp-validation-for="EnrollementDate" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CourseId" class="form-label">Course</label>
        @* asp-items pulls the SelectList we built in the controller *@
        <select asp-for="CourseId" asp-items="ViewBag.CourseId" class="form-select"></select>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // This only loads on THIS page, not globally — thanks to the
        // Scripts section defined in _Layout.cshtml.
        console.log("Create page loaded");
    </script>
}